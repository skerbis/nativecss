  "bugs": {
    "url": "https://github.com/skerbis/nativecss/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skerbis/nativecss.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/skerbis"
  },
  "license": "MIT",
  "author": "Thomas Skerbis (https://github.com/skerbis)",
  "contributors": [
    "KLXM Crossmedia (https://github.com/klxm)"
  ],
  "style": "dist/ncss.css",
  "exports": {
    ".": "./dist/ncss.css",
    "./ncss.css": "./dist/ncss.css",
    "./theme.css": "./dist/theme.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "LICENSE",
